	(text "1V AC RMS = 2.8V Peak to Peak / 2 = 1.4V Peak\nBias is 1.65V, so 1V AC RMS will be\nPeak to Peak from 0.25V to 3.05V\n"
		(exclude_from_sim no)
		(at 76.835 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "36f811e9-33bd-457b-b934-546a61296e7b")
	)
	(text "We set the DC Bias to 1.65V here,\nso the \"zero\" potential for AC voltage is 1.65V.\nThis is done, because we do not want to\nmeasure negative voltages for 1V AC."
		(exclude_from_sim no)
		(at 76.835 86.995 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3f8412c5-c30f-471b-b2ea-f80cf880756b")
	)
